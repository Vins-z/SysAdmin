# ==============================================================================
# ServerAdmin Application Stack Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment (production, staging, development)
APP_ENV=production
APP_NAME="ServerAdmin Production Portal"

# Host Ingress Port Bindings (Exposed by Nginx)
HOST_PORT_HTTP=80
HOST_PORT_HTTPS=443

# Redis Cache Configuration
ENABLE_REDIS=true
REDIS_PASSWORD=change_this_to_a_strong_secret_password_in_prod

# Log Level
LOG_LEVEL=info

